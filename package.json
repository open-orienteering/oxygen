{
  "name": "oxygen",
  "version": "0.1.0",
  "private": true,
  "description": "Oxygen - Lightweight orienteering management",
  "scripts": {
    "dev": "pnpm --parallel --filter './packages/*' dev",
    "build": "pnpm --filter './packages/*' build",
    "lint": "pnpm --filter './packages/*' lint",
    "test": "pnpm --filter './packages/*' test",
    "test:coverage": "pnpm --filter './packages/*' test:coverage",
    "test:integration": "pnpm --filter @oxygen/api test:integration",
    "test:e2e": "node scripts/e2e-sharded.mjs",
    "test:e2e:serial": "playwright test",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "db:generate": "pnpm --filter @oxygen/api db:generate",
    "db:push": "pnpm --filter @oxygen/api db:push",
    "db:migrate": "pnpm --filter @oxygen/api db:migrate",
    "db:migrate:dev": "pnpm --filter @oxygen/api db:migrate:dev",
    "migrate:mysql-to-pg": "pnpm --filter @oxygen/api migrate:mysql-to-pg",
    "docs:screenshots": "tsx docs/screenshots/capture.ts",
    "showcase:load": "bash scripts/load-showcase.sh",
    "audit:prod": "node scripts/audit-prod.mjs --audit-level=high",
    "test:scripts": "node --test scripts/__tests__/*.test.mjs"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@types/semver": "^7.8.0",
    "semver": "^7.8.5",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "i18next": "^26.5.3",
    "qrcode.react": "^4.2.0",
    "react-i18next": "^17.1.0",
    "svg-control-descriptions": "^2.1.0"
  },
  "pnpm": {
    "overrides": {
      "undici": "^7.30.1",
      "minimatch@<9.0.7": "^9.0.9",
      "flatted": "^3.4.4",
      "serialize-javascript": "^7.1.2",
      "effect": "^3.22.3",
      "postcss": "^8.5.31",
      "rollup@<4.59.0": "^4.64.10",
      "picomatch@<4.0.4": "^4.0.7",
      "defu": "^6.1.7",
      "vite@<7.3.5": "^7.3.7",
      "fast-uri@<3.1.6": "^3.1.8",
      "fast-uri@>=4.0.0 <4.1.3": "^4.2.2",
      "mysql2@<3.22.0": "^3.24.6",
      "fast-xml-builder@<1.1.7": "^1.3.1",
      "react-router@<7.18.2": "^7.18.4",
      "@babel/plugin-transform-modules-systemjs@<7.29.4": "^7.29.8",
      "ajv@>=7.0.0-alpha.0 <8.18.0": "^8.20.0",
      "brace-expansion@>=2.0.0 <2.1.4": "^2.1.7",
      "brace-expansion@>=3.0.0 <5.0.11": "^5.0.12",
      "protocol-buffers-schema@<3.6.1": "^3.6.1",
      "@xmldom/xmldom@<0.9.12": "^0.9.12",
      "find-my-way@<9.6.1": "^9.10.0",
      "nanoid@<3.3.18": "^3.3.20",
      "deepmerge-ts@<8.0.0": "^8.0.2",
      "jsdom": "~30.0.1"
    }
  }
}
