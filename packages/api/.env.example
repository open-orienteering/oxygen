# PostgreSQL connection for development.
# Schema must be `oxygen` — Prisma migrations create that schema.
DATABASE_URL="postgresql://oxygen:oxygen@localhost:5432/oxygen?schema=oxygen"

# API server
PORT=3001
HOST=0.0.0.0

# ── Identity (trusted proxy header) ──────────────────────────
# AUTH_MODE=off  — no gating (default; today's behaviour)
# AUTH_MODE=proxy — identity from AUTH_HEADER (must only be set by a
#   reverse proxy that STRIPS any client-supplied copy of that header)
# AUTH_MODE=dev  — always AUTH_DEV_EMAIL, auto-provisioned as admin
AUTH_MODE=off
AUTH_HEADER=x-forwarded-email
AUTH_DEV_EMAIL=dev@localhost
# Comma-separated emails auto-created as active admins on first request
OXYGEN_ADMIN_EMAILS=
