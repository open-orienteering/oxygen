{
  "name": "@oxygen/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "migrate:mysql-to-pg": "tsx scripts/migrate-mysql-to-pg.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.6",
    "@oxygen/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@resvg/resvg-js": "^2.6.2",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "adm-zip": "^0.6.1",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "geomagnetism": "^0.2.0",
    "google-auth-library": "^11.3.1",
    "jsdom": "~30.0.1",
    "mysql2": "^3.24.6",
    "ocad2geojson": "github:open-orienteering/ocad2geojson#v2.2.2-oxygen.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "proj4": "^2.22.0",
    "sharp": "^0.35.5",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.12",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  }
}
