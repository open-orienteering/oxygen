{
  "name": "@oxygen/api",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "migrate:mysql-to-pg": "tsx scripts/migrate-mysql-to-pg.ts",
    "golden:render": "tsx scripts/render-golden.ts",
    "document:from-ocd": "tsx scripts/ocd-to-document.ts",
    "demo-map:enrich": "tsx scripts/demo-map/enrich-okartan.mjs",
    "map:rematch": "tsx src/cli/map-rematch.ts",
    "route:calibrate": "tsx src/cli/calibrate-cost-model.ts",
    "event:restore": "tsx src/cli/restore-event.ts",
    "dem:live-check": "tsx scripts/dem-live-check.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/static": "^10.1.11",
    "@oxygen/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@resvg/resvg-js": "^2.6.2",
    "@trpc/client": "^11.28.0",
    "@trpc/server": "^11.28.0",
    "adm-zip": "^0.6.1",
    "dotenv": "^18.0.10",
    "fast-xml-parser": "^5.12.1",
    "fastify": "^5.12.8",
    "geomagnetism": "^0.2.0",
    "google-auth-library": "^11.3.4",
    "mysql2": "^3.24.6",
    "ocad2geojson": "github:open-orienteering/ocad2geojson#v2.2.2-oxygen.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "sharp": "^0.35.5",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
