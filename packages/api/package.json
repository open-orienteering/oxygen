{
  "name": "@oxygen/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "migrate:mysql-to-pg": "tsx scripts/migrate-mysql-to-pg.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@oxygen/shared": "workspace:*",
    "@prisma/client": "^6.19.3",
    "@resvg/resvg-js": "^2.6.2",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "adm-zip": "^0.6.0",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.12.0",
    "jsdom": "^30.0.1",
    "mysql2": "^3.23.3",
    "ocad2geojson": "github:marcus-kempe/ocad2geojson#v2.2.0-oxygen.0",
    "pg": "^8.23.0",
    "pino-pretty": "^13.1.3",
    "proj4": "^2.21.0",
    "sharp": "^0.35.3",
    "uuidv7": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@vitest/coverage-v8": "^4.1.10",
    "prisma": "^6.19.3",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
