// Oxygen schema — single PostgreSQL database, all tables in the `oxygen` schema.
//
// Conventions documented in docs/architecture.md (Database Architecture):
//   - Per-event entities use UUID v7 PK + a per-event integer `seq` (URL-stable).
//     `seq` is filled by a BEFORE INSERT trigger (see migration SQL).
//   - Append-only / immutable tables use UUID v7 only.
//   - Pure server-side tables (maps, tracks, routes) use BIGSERIAL.
//   - Global directories use their natural external IDs as PK.
//   - Status columns use native PG ENUM types.
//   - Wall-clock metadata: TIMESTAMPTZ. Race times: INTEGER deciseconds, ZeroTime-relative.
//   - JSONB for structured blobs.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // Node ESM (dist runs under plain `node`) needs explicit .js import
  // extensions — the extensionless default only works under bundlers/tsx.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["oxygen"]
}

// ─── Enums ─────────────────────────────────────────────────

enum RunnerStatus {
  unknown
  ok
  no_timing
  missing_punch
  dnf
  dq
  over_max_time
  out_of_competition
  dns
  cancel
  not_competing

  @@map("runner_status")
  @@schema("oxygen")
}

enum ControlStatus {
  ok
  bad
  multiple
  start
  finish
  no_timing
  optional
  bad_no_timing
  check
  clear
  readout

  @@map("control_status")
  @@schema("oxygen")
}

enum ClubControlType {
  normal
  srr

  @@map("club_control_type")
  @@schema("oxygen")
}

// ─── Registry & global tables ──────────────────────────────

/// An orienteering event — competition, training session, club evening, etc.
model Event {
  id             BigInt   @id @default(autoincrement())
  nameId         String   @unique @map("name_id")
  name           String
  /// Subtitle shown beneath the event name in UI.
  annotation     String   @default("")
  date           DateTime @db.Date
  /// Deciseconds since midnight. Default 324000 = 09:00:00.
  zeroTime       Int      @default(324000) @map("zero_time")
  kind           String   @default("competition")
  eventorEventId   BigInt?   @map("eventor_event_id")
  eventorEnv       String    @default("prod") @map("eventor_env")
  /// Timestamp of the last successful Eventor sync. NULL = never synced.
  eventorLastSync  DateTime? @map("eventor_last_sync") @db.Timestamptz(6)

  liveresultsTavid  Int?  @map("liveresults_tavid")
  liveresultsConfig Json? @map("liveresults_config")

  // Organizer
  organizerName      String  @default("") @map("organizer_name")
  organizerEventorId Int     @default(0) @map("organizer_eventor_id")
  email              String  @default("")
  homepage           String  @default("")
  phone              String  @default("")
  street             String  @default("")
  city               String  @default("")
  zip                String  @default("")
  orgNumber          String  @default("") @map("org_number")
  vatExempt          Boolean @default(true) @map("vat_exempt")

  // Fees (cents)
  cardFeeCents      Int    @default(0) @map("card_fee_cents")
  entryFeeCents     Int    @default(0) @map("entry_fee_cents")
  eliteFeeCents     Int    @default(0) @map("elite_fee_cents")
  youthFeeCents     Int    @default(0) @map("youth_fee_cents")
  youthAge          Int    @default(0) @map("youth_age") @db.SmallInt
  seniorAge         Int    @default(0) @map("senior_age") @db.SmallInt
  lateEntryFactor   String @default("") @map("late_entry_factor")
  ordinaryEntryDate Int    @default(0) @map("ordinary_entry_date")
  secondEntryDate   Int    @default(0) @map("second_entry_date")
  paymentDue        Int    @default(0) @map("payment_due")

  // Currency
  currencySymbol    String  @default("kr") @map("currency_symbol")
  currencySeparator String  @default(",") @map("currency_separator")
  currencyCode      String  @default("SEK") @map("currency_code")
  currencyPreSymbol Boolean @default(false) @map("currency_pre_symbol")
  currencyFactor    Int     @default(1) @map("currency_factor") @db.SmallInt

  // Was oxygen_competition_config
  airPlus                    Boolean @default(false) @map("air_plus")
  awakeHours                 Int     @default(6) @map("awake_hours")
  paymentMethods             String  @default("billed") @map("payment_methods")
  swishNumber                String  @default("") @map("swish_number")
  swishPayeeName             String  @default("") @map("swish_payee_name")
  printRegistrationReceipt   Boolean @default(false) @map("print_registration_receipt")
  registrationReceiptMessage String  @default("") @map("registration_receipt_message")
  finishReceiptMessage       String  @default("") @map("finish_receipt_message")
  receiptFriskvardNote       Boolean @default(false) @map("receipt_friskvard_note")
  webUrl                     String  @default("") @map("web_url")
  googleSheetsWebhookUrl     String  @default("") @map("google_sheets_webhook_url")
  liveloxEventId             Int?    @map("livelox_event_id")

  // Misc
  useEconomy   Boolean @default(false) @map("use_economy")
  useSpeaker   Boolean @default(false) @map("use_speaker")
  maxTime      Int     @default(0) @map("max_time")
  numStages    Int     @default(1) @map("num_stages") @db.SmallInt
  longTimes    Boolean @default(false) @map("long_times")
  subSeconds   Boolean @default(false) @map("sub_seconds")
  noVacantBib  Boolean @default(false) @map("no_vacant_bib")
  bibGap       Int     @default(0) @map("bib_gap") @db.SmallInt
  bibsPerClass Int     @default(0) @map("bibs_per_class") @db.SmallInt

  payModes    Json?  @map("pay_modes")
  startGroups Json?  @map("start_groups")
  controlMap  Json?  @map("control_map")
  lists       Json?
  machine     Json?
  spExtra     Json?  @map("sp_extra")
  ivExtra     Json?  @map("iv_extra")
  entryExtra  Json?  @map("entry_extra")
  splitPrint  String @default("") @map("split_print")

  removed   Boolean  @default(false)
  /// Device token for kiosk / start-screen URLs when AUTH_MODE is on.
  kioskKey  String?  @map("kiosk_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  controls     Control[]
  courses      Course[]
  classes      Class[]
  runners      Runner[]
  teams        Team[]
  cards        Card[]
  cardReadouts CardReadout[]
  cardReadoutBackups CardReadoutBackup[]
  punches      Punch[]
  controlUnits ControlUnit[]
  journal      JournalEntry[]
  journalSyncStates JournalSyncState[]
  leases       EventLease[]
  mapFiles     MapFile[]
  renderedMaps RenderedMap[]
  mapTiles     MapTile[]
  tracks       Track[]
  routes       Route[]
  eventSeqs    EventSeq[]
  eventPermissions EventPermission[]

  @@index([removed])
  @@map("events")
  @@schema("oxygen")
}

/// Per-(event, table) integer sequence allocator.
/// next_seq is the value that will be assigned to the NEXT row.
model EventSeq {
  eventId   BigInt @map("event_id")
  tableName String @map("table_name")
  nextSeq   Int    @default(1) @map("next_seq")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, tableName])
  @@map("event_seqs")
  @@schema("oxygen")
}

/// Global key-value store. Only truly global state:
/// eventor_api_key, eventor_api_key_test, runnerdb_last_sync,
/// runnerdb_runner_count, runnerdb_club_count.
model Setting {
  key   String  @id
  value String?

  @@map("settings")
  @@schema("oxygen")
}

/// Cluster-wide singleton lease, one row per named responsibility (today
/// only "background-jobs"). The holder renews it on a timer; any instance
/// may take it over once `expires_at` has passed, which is how leadership
/// survives an instance being recycled. Expiry is compared against the
/// database's `now()`, so instance clock skew never affects the outcome.
model InstanceLease {
  name       String   @id @db.VarChar(64)
  holderId   String   @map("holder_id") @db.VarChar(64)
  acquiredAt DateTime @default(now()) @map("acquired_at") @db.Timestamptz(6)
  renewedAt  DateTime @default(now()) @map("renewed_at") @db.Timestamptz(6)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)

  @@map("instance_lease")
  @@schema("oxygen")
}

/// Invite-only operator identity. Email is the stable key (always lowercase).
/// Passwords are never stored — identity arrives from a trusted proxy header.
model User {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email       String    @unique
  displayName String    @default("") @map("display_name")
  isAdmin     Boolean   @default(false) @map("is_admin")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastSeenAt  DateTime? @map("last_seen_at") @db.Timestamptz(6)

  eventPermissions EventPermission[]     @relation("GrantSubject")
  grantsGiven      EventPermission[]     @relation("GrantActor")
  clubMapFiles     ClubMapFile[]
  clubGroupMemberships ClubUserGroupMember[]

  @@map("users")
  @@schema("oxygen")
}

model PermissionGroup {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name         String   @unique
  capabilities Json
  isSystem     Boolean  @default(false) @map("is_system")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  grants EventPermission[]

  @@map("permission_groups")
  @@schema("oxygen")
}

model EventPermission {
  id      String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId BigInt @map("event_id")
  /// Subject: exactly one of userId / clubGroupId (CHECK constraint).
  userId      String?  @map("user_id") @db.Uuid
  clubGroupId String?  @map("club_group_id") @db.Uuid
  groupId     String   @map("group_id") @db.Uuid
  grantedBy   String?  @map("granted_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User?           @relation("GrantSubject", fields: [userId], references: [id], onDelete: Cascade)
  clubGroup ClubUserGroup?  @relation(fields: [clubGroupId], references: [id], onDelete: Cascade)
  group     PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  granter   User?           @relation("GrantActor", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@unique([eventId, userId, groupId])
  @@unique([eventId, clubGroupId, groupId])
  @@index([eventId, userId])
  @@index([eventId, clubGroupId])
  @@map("event_permissions")
  @@schema("oxygen")
}

/// Club-defined set of users ("Youth trainers", "Board", …). Grants can
/// target a group instead of a single user; membership changes apply to
/// every event the group is granted on, immediately.
model ClubUserGroup {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  members ClubUserGroupMember[]
  grants  EventPermission[]

  @@map("club_user_groups")
  @@schema("oxygen")
}

model ClubUserGroupMember {
  groupId String   @map("group_id") @db.Uuid
  userId  String   @map("user_id") @db.Uuid
  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  group ClubUserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("club_user_group_members")
  @@schema("oxygen")
}

/// Global runner directory synced from Eventor (was oxygen_runner_db).
model RunnerDirectory {
  eventorPersonId BigInt   @id @map("eventor_person_id")
  name            String   @default("")
  cardNo          Int      @default(0) @map("card_no")
  eventorClubId   Int      @default(0) @map("eventor_club_id")
  birthYear       Int      @default(0) @map("birth_year") @db.SmallInt
  sex             String   @default("") @db.Char(1)
  nationality     String   @default("")
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([cardNo])
  @@index([name])
  @@index([eventorClubId])
  @@map("runner_directory")
  @@schema("oxygen")
}

/// Global club directory synced from Eventor + logos.
/// Replaces both oxygen_club_db (MeOSMain) and per-event oxygen_club_logo.
model ClubDirectory {
  eventorId    BigInt   @id @map("eventor_id")
  name         String   @default("")
  shortName    String   @default("") @map("short_name")
  countryCode  String   @default("") @map("country_code") @db.Char(3)
  smallLogoPng Bytes?   @map("small_logo_png")
  largeLogoPng Bytes?   @map("large_logo_png")
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("club_directory")
  @@schema("oxygen")
}

/// Eventor event metadata cache for Registration Trends page.
model EventorEventMeta {
  eventorEventId   Int      @id @map("eventor_event_id")
  name             String   @default("")
  startDate        DateTime @map("start_date") @db.Date
  classificationId Int      @default(0) @map("classification_id")
  organiser        String   @default("")
  entryCount       Int      @default(0) @map("entry_count")
  fetchedAt        DateTime @map("fetched_at") @db.Timestamptz(6)

  entryHistory EventorEntryHistory[]

  @@map("eventor_event_meta")
  @@schema("oxygen")
}

model EventorEntryHistory {
  eventorEventId Int      @map("eventor_event_id")
  rowSeq         Int      @map("row_seq")
  entryClassId   Int      @default(0) @map("entry_class_id")
  entryAt        DateTime @map("entry_at") @db.Timestamptz(6)

  event EventorEventMeta @relation(fields: [eventorEventId], references: [eventorEventId], onDelete: Cascade)

  @@id([eventorEventId, rowSeq])
  @@map("eventor_entry_history")
  @@schema("oxygen")
}

// ─── Per-event entities ────────────────────────────────────

model Control {
  id         String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId    BigInt        @map("event_id")
  seq        Int           @default(0)
  name       String        @default("")
  /// ';'-separated list of accepted punch codes (multi-code controls).
  codes      String        @default("")
  status     ControlStatus @default(ok)
  timeAdjust Int           @default(0) @map("time_adjust")
  minTime    Int           @default(0) @map("min_time")
  /// OCD map X coordinate (real decimal value).
  xpos       Float         @default(0) @db.DoublePrecision
  ypos       Float         @default(0) @db.DoublePrecision
  /// WGS84 latitude (real decimal value). NULL until coords are imported.
  lat        Float?        @db.DoublePrecision
  lng        Float?        @db.DoublePrecision
  radioType  String        @default("normal") @map("radio_type")
  airPlus    String        @default("default") @map("air_plus")
  /// AIR+ autosend override. One of 'last' (only most recent unsent
  /// punch), 'unsent' (every never-sent punch), 'all' (resend
  /// everything every connection). Default 'last' matches stock SI
  /// firmware behaviour and what the operator picks 95% of the time.
  autosendMode String      @default("last") @map("autosend_mode")
  /// IOF control description ({ c?, d?, g?, s?, f? } — OCAD text encoding).
  /// The description belongs to the control site, not to any course.
  description Json?
  removed    Boolean       @default(false)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  event           Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  finishOfCourses Course[]        @relation("CourseFinishControl")
  courseControls  CourseControl[]
  punches         Punch[]
  controlUnits    ControlUnit[]

  @@unique([eventId, seq])
  @@index([eventId, removed])
  @@map("controls")
  @@schema("oxygen")
}

model Course {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId         BigInt   @map("event_id")
  seq             Int      @default(0)
  name            String   @default("")
  lengthM         Int      @default(0) @map("length_m")
  climbM          Int      @default(0) @map("climb_m")
  numberOfMaps    Int      @default(0) @map("number_of_maps")
  startName       String   @default("") @map("start_name")
  legs            String   @default("")
  firstAsStart    Boolean  @default(false) @map("first_as_start")
  lastAsFinish    Boolean  @default(false) @map("last_as_finish")
  finishControlId String?  @map("finish_control_id") @db.Uuid
  shorten         Int      @default(0)
  /// GeoJSON FeatureCollection for control + leg overlay. Populated by the OCAD / IOF course importer.
  geometry        Json?
  /// Provenance for `geometry`: 'ocd' (full routed legs from OCAD) or 'xml' (straight-line fallback from IOF XML).
  geometrySource  String   @default("") @map("geometry_source")
  removed         Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  finishControl  Control?          @relation("CourseFinishControl", fields: [finishControlId], references: [id], onDelete: SetNull)
  courseControls CourseControl[]
  classes        Class[]
  runners        Runner[]
  classPools     ClassCoursePool[]

  @@unique([eventId, seq])
  @@index([eventId, removed])
  @@map("courses")
  @@schema("oxygen")
}

/// Normalised replacement for oCourse.Controls "123;456;789".
model CourseControl {
  courseId  String @map("course_id") @db.Uuid
  position  Int
  controlId String @map("control_id") @db.Uuid

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  control Control @relation(fields: [controlId], references: [id], onDelete: Restrict)

  @@id([courseId, position])
  @@index([controlId])
  @@map("course_controls")
  @@schema("oxygen")
}

model Class {
  id        String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId   BigInt  @map("event_id")
  seq       Int     @default(0)
  name      String  @default("")
  longName  String  @default("") @map("long_name")
  courseId  String? @map("course_id") @db.Uuid
  eventorId BigInt? @map("eventor_id")

  lowAge    Int    @default(0) @map("low_age") @db.SmallInt
  highAge   Int    @default(0) @map("high_age") @db.SmallInt
  sex       String @default("")
  classType String @default("") @map("class_type")

  classFeeCents              Int @default(0) @map("class_fee_cents")
  classFeeRedCents           Int @default(0) @map("class_fee_red_cents")
  highClassFeeCents          Int @default(0) @map("high_class_fee_cents")
  highClassFeeRedCents       Int @default(0) @map("high_class_fee_red_cents")
  secondHighClassFeeCents    Int @default(0) @map("second_high_class_fee_cents")
  secondHighClassFeeRedCents Int @default(0) @map("second_high_class_fee_red_cents")

  allowQuickEntry Boolean @default(false) @map("allow_quick_entry")
  vacantCount     Int     @default(0) @map("vacant_count")
  reservedCount   Int     @default(0) @map("reserved_count")

  startName     String  @default("") @map("start_name")
  startBlock    Int     @default(0) @map("start_block")
  noTiming      Boolean @default(false) @map("no_timing")
  freeStart     Boolean @default(false) @map("free_start")
  requestStart  Boolean @default(false) @map("request_start")
  ignoreStart   Boolean @default(false) @map("ignore_start")
  firstStart    Int     @default(0) @map("first_start")
  startInterval Int     @default(0) @map("start_interval")

  sortIndex     Int     @default(0) @map("sort_index")
  maxTime       Int     @default(0) @map("max_time")
  /// Free-form MeOS tournament-status code (typically empty; values like "Q","F1","F2" for qualifying schemes).
  status        String  @default("")
  directResult  Boolean @default(false) @map("direct_result")
  bib           String  @default("")
  bibMode       String  @default("") @map("bib_mode")
  unordered     Boolean @default(false)
  numberMaps    Int     @default(0) @map("number_maps")
  result        String  @default("")
  legMethod     String  @default("") @map("leg_method")
  qualification Json?
  transferFlags Int     @default(0) @map("transfer_flags")

  removed   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  course      Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)
  runners     Runner[]
  teams       Team[]
  routes      Route[]
  coursePools ClassCoursePool[]

  @@unique([eventId, seq])
  @@index([eventId, removed])
  @@index([courseId])
  @@index([eventId, eventorId])
  @@map("classes")
  @@schema("oxygen")
}

/// Forking: a class may pull from a pool of courses per stage.
model ClassCoursePool {
  classId  String @map("class_id") @db.Uuid
  stage    Int    @default(0) @db.SmallInt
  courseId String @map("course_id") @db.Uuid

  class  Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([classId, stage, courseId])
  @@map("class_course_pools")
  @@schema("oxygen")
}

model Runner {
  id            String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId       BigInt       @map("event_id")
  seq           Int          @default(0)
  classId       String?      @map("class_id") @db.Uuid
  /// Free-text club name. Empty when clubless. Eventor clubs populate this AND eventorClubId.
  clubName      String       @default("") @map("club_name")
  /// Eventor club ID (references global club_directory).
  eventorClubId BigInt?      @map("eventor_club_id")
  courseId      String?      @map("course_id") @db.Uuid
  cardId        String?      @map("card_id") @db.Uuid
  name          String       @default("")
  /// SI card number. NULL = no card assigned (cardless runner). Enforced
  /// unique per event — NULLs are distinct in Postgres, so cardless runners
  /// coexist. Replaces the legacy `0`-as-sentinel.
  cardNo        Int?         @map("card_no")
  startNo       Int          @default(0) @map("start_no")
  /// Deciseconds, ZeroTime-relative.
  startTime     Int          @default(0) @map("start_time")
  finishTime    Int          @default(0) @map("finish_time")
  status        RunnerStatus @default(unknown)

  bib         String @default("")
  birthYear   Int    @default(0) @map("birth_year") @db.SmallInt
  sex         String @default("")
  nationality String @default("")
  country     String @default("")
  phone       String @default("")

  entryDate       Int     @default(0) @map("entry_date")
  entryTime       Int     @default(0) @map("entry_time")
  entrySource     Int     @default(0) @map("entry_source")
  eventorPersonId BigInt? @map("eventor_person_id")
  eventorEntryId  BigInt? @map("eventor_entry_id")

  feeCents     Int     @default(0) @map("fee_cents")
  cardFeeCents Int     @default(0) @map("card_fee_cents")
  paidCents    Int     @default(0) @map("paid_cents")
  payMode      Int     @default(0) @map("pay_mode") @db.SmallInt
  taxableCents Int     @default(0) @map("taxable_cents")
  cardReturned Boolean @default(false) @map("card_returned")

  inputTime    Int          @default(0) @map("input_time")
  inputStatus  RunnerStatus @default(unknown) @map("input_status")
  inputPoints  Int          @default(0) @map("input_points")
  inputPlace   Int          @default(0) @map("input_place")
  inputResult  Json?        @map("input_result")
  multiResults Json?        @map("multi_results")

  rank          Int     @default(0)
  priority      Int     @default(0) @db.SmallInt
  timeAdjust    Int     @default(0) @map("time_adjust")
  pointAdjust   Int     @default(0) @map("point_adjust")
  transferFlags Int     @default(0) @map("transfer_flags")
  shorten       Boolean @default(false)
  startGroup    Int     @default(0) @map("start_group")
  noRestart     Boolean @default(false) @map("no_restart")
  heat          Int     @default(0) @db.SmallInt
  reference     Int     @default(0)
  family        Int     @default(0)
  annotation    String  @default("")

  removed   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  class  Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  card   Card?   @relation(fields: [cardId], references: [id], onDelete: SetNull)
  routes Route[]

  @@unique([eventId, seq])
  // One-card-per-event is enforced by a PARTIAL unique index
  // `runners_event_id_card_no_key` ON (event_id, card_no) WHERE removed = false
  // (created in the 20260601120000 migration). Prisma's `@@unique` cannot
  // express the `WHERE removed = false` predicate — soft-deleted runners must
  // free their card — so the index lives in raw migration SQL. It also serves
  // the (event_id, card_no) lookups, which all filter removed = false.
  @@index([eventId, classId, removed])
  @@index([eventId, eventorClubId, removed])
  @@index([eventId, status, removed])
  @@index([eventId, startTime])
  @@index([eventId, eventorPersonId])
  @@map("runners")
  @@schema("oxygen")
}

