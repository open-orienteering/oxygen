  batteryVoltageMv   Int?      @map("battery_voltage_mv")
  batteryLow         Boolean   @default(false) @map("battery_low")
  checkedAt          DateTime? @map("checked_at") @db.Timestamptz(6)
  memoryClearedAt    DateTime? @map("memory_cleared_at") @db.Timestamptz(6)
  firmwareVersion    String?   @map("firmware_version")
  modelId            Int?      @map("model_id")
  modelName          String?   @map("model_name")
  /// SRR_CFG bit read from the station during programming. True =
  /// hardware short-range radio (SRR) is enabled on this unit, which
  /// the Controls page surfaces as an "SRR+" badge so the operator
  /// can confirm punches will be forwarded over the radio link.
  srrCfg             Boolean   @default(false) @map("srr_cfg")
