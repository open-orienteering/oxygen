  @@unique([eventId, seq])
  @@unique([eventId, stationSerial])
  @@index([controlId])
  @@map("control_units")
  @@schema("oxygen")
}

// ─── Append-only / immutable tables ────────────────────────

/// Raw SI card read log (was oxygen_card_readouts). Client-mintable UUID.
model CardReadout {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId    BigInt   @map("event_id")
  cardNo     Int      @map("card_no")
  cardType   String   @default("") @map("card_type")
  /// [{code,time,subSecond,unit}, ...]
  punches    Json
  voltageMv  Int      @default(0) @map("voltage_mv")
  batteryLow Boolean? @map("battery_low")
  ownerData  Json?    @map("owner_data")
  metadata   Json?
  stationId  String?  @map("station_id")
  readAt     DateTime @default(now()) @map("read_at") @db.Timestamptz(6)

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  cards Card[]

  @@index([eventId, cardNo])
  @@index([eventId, readAt(sort: Desc)])
  @@map("card_readouts")
  @@schema("oxygen")
}

/// Staging table for card readouts recovered from a readout-station's backup
/// flash. Populated by `cardReadout.importReadoutBackups` after dumping
/// SI station memory in M_READOUT mode (see docs/si-protocol/readout-backup/).
/// Rows live here until promoted into `card_readouts` by `pushReadoutBackup`.
model CardReadoutBackup {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId         BigInt    @map("event_id")

  /// SI serial of the readout station that produced this backup (debug).
  stationSerial   Int?      @map("station_serial")
  /// Address within the station's flash where this slot was found (debug).
  slotAddress     Int       @map("slot_address")

  cardNo          Int       @map("card_no")
  cardType        String    @default("") @map("card_type")
  /// [{controlCode,time,subSecond?}, ...]
  punches         Json
  /// Deciseconds since midnight; null when the card had no value.
  startTime       Int?      @map("start_time")
  finishTime      Int?      @map("finish_time")
  checkTime       Int?      @map("check_time")
  clearTime       Int?      @map("clear_time")
  /// Original read-time stamp if decoded from the 4-byte slot header.
  /// NULL until that header's semantics are known.
  originalReadAt  DateTime? @map("original_read_at") @db.Timestamptz(6)
  /// Card owner data (SI10/SIAC/SI11 only), if present on card.
  ownerData       Json?     @map("owner_data")
  /// Hash of (cardNo + sorted-by-time controlCode/time punches list).
  /// Same card + same logical readout → same hash → unique constraint kicks
  /// in on re-import, regardless of which station/slot it came from.
  punchesHash     String    @map("punches_hash")

  importedAt      DateTime  @default(now()) @map("imported_at") @db.Timestamptz(6)
  /// Set when the backup is promoted into card_readouts by pushReadoutBackup.
  pushedAt        DateTime? @map("pushed_at") @db.Timestamptz(6)
  pushedReadoutId String?   @map("pushed_readout_id") @db.Uuid

  /// Raw slot bytes — kept by default for forensics + future format work.
  /// Can be cleared with a future cleanRawBytes mutation once an event closes.
  rawBytes        Bytes?    @map("raw_bytes")

  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, punchesHash])
  @@index([eventId, cardNo])
  @@index([eventId, pushedAt])
  @@map("card_readout_backups")
  @@schema("oxygen")
}

/// Free / online-input / backup-unit punches (was oPunch + oxygen_control_punches).
model Punch {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId     BigInt    @map("event_id")
  cardNo      Int       @map("card_no")
  controlCode Int       @map("control_code")
  controlId   String?   @map("control_id") @db.Uuid
  unitId      String?   @map("unit_id") @db.Uuid
  /// Deciseconds, ZeroTime-relative.
  time        Int
  punchedAt   DateTime? @map("punched_at") @db.Timestamptz(6)
  subSecond   Int?      @map("sub_second") @db.SmallInt
  /// 'card' | 'online_input' | 'backup_memory' | 'manual'
  source      String    @default("card")
  isOriginal  Boolean   @default(true) @map("is_original")
  importedAt  DateTime  @default(now()) @map("imported_at") @db.Timestamptz(6)
  removed     Boolean   @default(false)

  event   Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  control Control?     @relation(fields: [controlId], references: [id], onDelete: SetNull)
  unit    ControlUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([eventId, cardNo])
  @@index([eventId, controlId])
  @@index([eventId, importedAt(sort: Desc)])
  @@map("punches")
  @@schema("oxygen")
}

/// Append-only journal of mutations — the offline-first CRDT wire format
/// (was oxygen_events / event_log). eventId references the orienteering event;
/// each entry has its own UUID id and an HLC sort key. See
/// docs/offline-architecture.md.
model JournalEntry {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId         BigInt   @map("event_id")
  type            String
  stationId       String   @map("station_id")
  /// Verifiable "who did this" attribution. NULL for background jobs,
  /// pullers, and peer ingest; tRPC mutations stamp the authenticated user.
  actorId         String?  @map("actor_id") @db.Uuid
  /// Encoded hybrid logical clock (physical_ms << 16 | logical), the journal's
  /// canonical total-order sort key. Synthesised from clientTimestamp for
  /// legacy clients that predate HLC.
  hlc             BigInt   @default(0)
  schemaVersion   Int      @default(1) @map("schema_version")
  clientTimestamp DateTime @map("client_timestamp") @db.Timestamptz(6)
  payload         Json
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, hlc])
  @@index([eventId, clientTimestamp(sort: Desc)])
  @@index([eventId, type])
  @@map("journal")
  @@schema("oxygen")
}

/// Per-event single-writer lease (pivot Step 4). One row per checkout; the
/// active lease is the row with released_at IS NULL (enforced unique per
/// event by a partial index in the migration). Race-critical mutations on a
/// node that is NOT the holder get a typed PRECONDITION_FAILED — see
/// `assertRaceWritable` in sync/lease.ts.
model EventLease {
  id           BigInt    @id @default(autoincrement())
  eventId      BigInt    @map("event_id")
  /// NODE_ID of the node that owns race-critical writes for this event.
  holderNodeId String    @map("holder_node_id")
  acquiredAt   DateTime  @default(now()) @map("acquired_at") @db.Timestamptz(6)
  releasedAt   DateTime? @map("released_at") @db.Timestamptz(6)
  /// True when the lease was ended by forceTakeover rather than checkin.
  forced       Boolean   @default(false)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, releasedAt])
  @@map("event_lease")
  @@schema("oxygen")
}

/// Per-peer journal-shipping watermarks (pivot Step 3). One row per
/// (peer, event); cursors are (hlc, id) pairs because encoded HLCs can tie
/// across stations. A watermark only advances after contiguous application,
/// so it never skips past an unshipped/unapplied entry.
model JournalSyncState {
  /// Peer identifier — the normalized SYNC_PEER_URL of the peer node.
  peerId  String @map("peer_id")
  eventId BigInt @map("event_id")

  /// Last local entry pushed to AND acked by the peer.
  pushedHlc BigInt @default(0) @map("pushed_hlc")
  pushedId  String @default("") @map("pushed_id")

  /// Last peer entry pulled AND applied locally.
  pulledHlc BigInt @default(0) @map("pulled_hlc")
  pulledId  String @default("") @map("pulled_id")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([peerId, eventId])
  @@map("journal_sync_state")
  @@schema("oxygen")
}

