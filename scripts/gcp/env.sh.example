# GCP deployment configuration for Oxygen.
#
# Copy to scripts/gcp/env.sh, fill in your values, and keep it out of git
# (scripts/gcp/env.sh is gitignored). All scripts in this directory source
# it. See docs/deploy-gcp-cloud-run.md for the full runbook.

# Your GCP project id (not the display name).
export PROJECT_ID="my-club-oxygen"

# Tier-1 pricing region close to you. europe-north1 = Finland,
# europe-north2 = Stockholm. NOTE: if you want a custom domain via the
# free Cloud Run domain mapping, the region must be on the supported
# list (europe-north1 is, europe-north2 is NOT):
# https://cloud.google.com/run/docs/locations#domains
export REGION="europe-north1"

# Cloud Run service name.
export SERVICE="oxygen"

# Artifact Registry repository for the image.
export AR_REPO="oxygen"

# Cloud SQL instance / database / user names.
export SQL_INSTANCE="oxygen-pg"
export DB_NAME="oxygen"
export DB_USER="oxygen"

# Derived — no need to edit.
export IMAGE="${REGION}-docker.pkg.dev/${PROJECT_ID}/${AR_REPO}/${SERVICE}"
export SQL_CONNECTION="${PROJECT_ID}:${REGION}:${SQL_INSTANCE}"
